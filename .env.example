# Copy to .env (git-ignored) and fill in locally. Never commit real values.
ANTHROPIC_API_KEY=
GODADDY_PAT=
PAGESPEED_API_KEY=
YOUTUBE_API_KEY=
DATABASE_URL=jdbc:postgresql://localhost:5433/launchmate
DATABASE_USERNAME=launchmate
DATABASE_PASSWORD=
JWT_SECRET=
MAIL_USERNAME=
MAIL_PASSWORD=

# Public address of the site (used in password-reset links) and outgoing mail.
# Mail stays off until the support@growbie.in mailbox exists; while off, reset links are written to the backend log.
PUBLIC_URL=http://localhost:5173
MAIL_ENABLED=false
MAIL_FROM=support@growbie.in
MAIL_HOST=smtpout.secureserver.net
MAIL_PORT=465
